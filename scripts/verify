#!/bin/sh
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_root"

exec ./gradlew \
    :androidApp:assembleDebug \
    :androidApp:assembleUiTestAndroidTest \
    :shared:testAndroidHostTest \
    :shared:jvmTest \
    :shared:compileCommonMainKotlinMetadata \
    :androidApp:lintDebug \
    --console=plain \
    "$@"
